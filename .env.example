# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# --- Global Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Set to 'true' to safely populate default sample users and catalog products in development
APP_SEED_DATA_ENABLED=false

# --- Spring Cloud Gateway (Port 8080) ---
GATEWAY_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Service Downstream URLs for Gateway Routing
USER_SERVICE_URL=http://localhost:8081
PRODUCT_SERVICE_URL=http://localhost:8082
ORDER_SERVICE_URL=http://localhost:8083

# --- User Service (Port 8081) ---
USER_SERVICE_PORT=8081
# Neon PostgreSQL connection string template:
# jdbc:postgresql://<endpoint-id>.us-east-2.aws.neon.tech/<dbname>?sslmode=require&currentSchema=users_schema
USER_DB_URL=jdbc:postgresql://your-neon-host.neon.tech/neondb?sslmode=require&currentSchema=users_schema
USER_DB_USERNAME=your_neon_db_username
USER_DB_PASSWORD=your_neon_db_password

# --- Product Service (Port 8082) ---
PRODUCT_SERVICE_PORT=8082
PRODUCT_DB_URL=jdbc:postgresql://your-neon-host.neon.tech/neondb?sslmode=require&currentSchema=products_schema
PRODUCT_DB_USERNAME=your_neon_db_username
PRODUCT_DB_PASSWORD=your_neon_db_password

# --- Order Service (Port 8083) ---
ORDER_SERVICE_PORT=8083
ORDER_DB_URL=jdbc:postgresql://your-neon-host.neon.tech/neondb?sslmode=require&currentSchema=orders_schema
ORDER_DB_USERNAME=your_neon_db_username
ORDER_DB_PASSWORD=your_neon_db_password

# --- Future Day 4 Security Settings ---
# Generate a secure 256-bit or 512-bit HMAC secret for production
JWT_SECRET=your_jwt_signing_secret_min_32_characters_long_example
JWT_EXPIRATION_MS=86400000

# --- React Frontend Configuration ---
VITE_API_GATEWAY_URL=http://localhost:8080
